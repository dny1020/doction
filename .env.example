# ── Required ───────────────────────────────────────────────────────────────────

# Password for the `doction` Postgres role — CHANGE THIS. Generate with: openssl rand -hex 24
# compose.yaml builds DATABASE_URL from this automatically.
POSTGRES_PASSWORD=change-me

# Key that signs session cookies and JWTs — CHANGE THIS. Generate with: openssl rand -hex 32
# With SECURE_COOKIES=1 the server refuses to start on `change-me`.
SECRET_KEY=change-me

# ── Access ─────────────────────────────────────────────────────────────────────

# Set to 1 when running behind a TLS-terminating reverse proxy.
SECURE_COOKIES=0

# Set to 1 to close public sign-up (open by default). The first user can still register;
# everyone after that is added by a workspace owner.
DISABLE_REGISTRATION=0

# Where this instance's source lives, shown in Settings. AGPL-3.0: a modified deployment
# must point this at its own code.
SOURCE_URL=https://github.com/dny1020/doction

# ── Search (opt-in) ────────────────────────────────────────────────────────────

# Set to 1 to enable local semantic search (sgrep / rag). The model ships in the image
# and loads lazily, so this costs nothing until a query needs it.
SEMANTIC_SEARCH=0

# Set to 1 to rerank semantic hits with a cross-encoder (needs SEMANTIC_SEARCH=1).
# Leave it off: measured as a net loss, see evals/results/.
RERANK=0

# ── OCR of uploads (opt-in) ────────────────────────────────────────────────────

# Set to 1 to index the text inside uploaded images with tesseract, so a pasted
# screenshot becomes searchable. Runs in the background; a failure never breaks the upload.
OCR_UPLOADS=0
OCR_LANGS=eng+spa

# ── Logging ────────────────────────────────────────────────────────────────────

# Root logger level (DEBUG/INFO/WARNING/ERROR). Logs go to stdout and to a rotated
# file under LOG_DIR.
LOG_LEVEL=INFO

# ── Paths (not set here) ───────────────────────────────────────────────────────
# DATA_DIR (/data) and LOG_DIR (/logs) are container paths satisfied by compose.yaml's
# bind mounts; change the host side there. DATA_DIR and the Postgres volume are the two
# halves of a backup.
