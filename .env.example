# ── Required ───────────────────────────────────────────────────────────────────

# Password for the `doction` Postgres role — CHANGE THIS. Generate with: openssl rand -hex 24
# compose.yaml builds DATABASE_URL from this automatically.
POSTGRES_PASSWORD=change-me

# Key used to sign session cookies and JWTs — CHANGE THIS. Generate with: openssl rand -hex 32
# `change-me` counts as unset: with SECURE_COOKIES=1 the server refuses to start rather
# than sign tokens with a placeholder that is public on GitHub.
SECRET_KEY=change-me

# ── Access ─────────────────────────────────────────────────────────────────────

# Set to 1 when running behind a TLS-terminating reverse proxy.
SECURE_COOKIES=0

# Set to 1 to close public sign-up. Registration is OPEN by default: on a reachable
# instance, anyone who finds the URL can create an account. With this on, the first user
# can still register (so a fresh instance is never locked out) and everyone after that
# has to be added as a workspace member by an owner.
DISABLE_REGISTRATION=0

# Where THIS instance's source lives. Shown to signed-in users in Settings. AGPL-3.0
# obliges an operator who modified doction and serves it over a network to offer their
# source to the people using it, so a modified fork has to point this at its own code:
# leaving the upstream URL would be a false claim of compliance. An unmodified deployment
# does not need to touch it.
SOURCE_URL=https://github.com/dny1020/doction

# ── Search (opt-in) ────────────────────────────────────────────────────────────

# Set to 1 to enable local semantic search (sgrep / rag). The model ships in the image
# and loads lazily, so this costs nothing until a query needs it.
SEMANTIC_SEARCH=0

# Set to 1 to re-score the top semantic hits with a local cross-encoder. Requires
# SEMANTIC_SEARCH=1. LEAVE THIS OFF: measured on a real corpus it buys +0.01 MRR, loses
# recall@1 (0.57 vs 0.61) and costs 29x the median latency. See evals/results/.
RERANK=0

# ── OCR of uploads (opt-in) ────────────────────────────────────────────────────

# Set to 1 to index the text inside uploaded images with tesseract, so a pasted
# screenshot becomes searchable. Runs in the background; a failure never breaks the upload.
OCR_UPLOADS=0
OCR_LANGS=eng+spa

# ── Logging ────────────────────────────────────────────────────────────────────

# Root logger level (DEBUG/INFO/WARNING/ERROR). Logs go to stdout and to a rotated
# file under LOG_DIR.
LOG_LEVEL=INFO

# ── Paths (not set here) ───────────────────────────────────────────────────────
#
# DATA_DIR (/data) and LOG_DIR (/logs) are container paths that compose.yaml already
# satisfies with its bind mounts (./data and ./data/logs). Change the host side of the
# mount in compose.yaml, not these — overriding them here would point the app somewhere
# the volumes do not reach.
#
# DATA_DIR holds the git repo of markdown pages plus uploads. It and the Postgres volume
# are the two halves of a backup: one without the other does not restore.
