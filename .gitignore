__pycache__/
*.py[cod]
.venv/
*.db
*.db-shm
*.db-wal
.pytest_cache/
.ruff_cache/
*.un~
data/
uploads/
jobs_output.log
.env
CLAUDE.md
.claude/
# Maintainer-local planning and agent orientation, not part of the distributed source.
openspec/
AGENTS.md
models/
important.md
# A blanket `*.txt` silently hid any future text file, so only the disposable ones
# are listed.
requirements*.txt
notas*.txt

# Frontend dependencies and build artifacts; the bundle comes from `npm run build`
# or Docker's `web` stage.
node_modules/
frontend/dist/
app/static/app/

# Loose mockups and prototypes: local design artifacts, not part of doction.
/*.html

# The eval corpus is a dump of the personal wiki. The repository is public, so this
# is the only thing between a distracted `git add -A` and publishing private notes.
evals/corpus/
evals/corpus*/
*.corpus/

# Working screenshots, which pile up in the root while reviewing a visual change.
# The product's own live in docs/assets/.
/*.png
/*.jpg
/*.jpeg

# Sensitive material, just in case: in a public repo the rule costs nothing and the
# omission does not.
*.pem
*.key
*.p12
.env.*
!.env.example

graphify-out/
.claudeignore
.agents/

# The documentation site and its staging tree, both regenerated by `make docs` from
# the same tracked files.
build/
site/
